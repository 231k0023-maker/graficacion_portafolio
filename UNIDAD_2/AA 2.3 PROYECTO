
function setup() {
  createCanvas(windowWidth, windowHeight);
  rectMode(CENTER);
  angleMode(DEGREES);
}

function draw() {
  background(10, 14, 30);

  push();
  scale(width / 400, height / 400);

  fill(255, 255, 255, 15);
  noStroke();
  ellipse(30, 30, 80, 80);

  fill(255, 235, 59);
  stroke(255, 235, 59);
  strokeWeight(1);
  ellipse(30, 30, 40, 50);

  fill(120, 120, 130);
  stroke(120, 120, 130);
  strokeWeight(1);
  ellipse(80 + (frameCount % 400), 20, 50, 25);
  ellipse(100 + (frameCount % 400), 25, 40, 20);

  fill(10, 40, 110);
  stroke(0, 20, 70);
  strokeWeight(2);
  rect(365, 120, 90, 180);

  drawLogoTuerca(365, 105, 0.65);

  fill(230, 230, 235);
  stroke(160, 160, 170);
  strokeWeight(2);
  rect(25, 130, 90, 160);

  fill(0, 90, 180);
  stroke(255);
  strokeWeight(1);
  rect(20, 130, 24, 24);
  fill(255);
  stroke(255);
  ellipse(20, 124, 5, 5);
  rect(20, 132, 10, 8);

  fill(50);
  stroke(20);
  strokeWeight(1);
  rect(72, 90, 4, 60);
  fill(255, 240, 150, 70);
  ellipse(72, 55, 25, 25);
  fill(255, 240, 150);
  ellipse(72, 55, 10, 10);

  fill(170);
  stroke(90);
  strokeWeight(1.5);
  for (let rx = 85; rx <= 135; rx += 10) {
    rect(rx, 130, 3, 90);
  }

  for (let rx = 245; rx <= 295; rx += 10) {
    rect(rx, 130, 3, 90);
  }

  fill(180, 150, 120);
  stroke(110, 90, 70);
  strokeWeight(2);
  rect(190, 130, 100, 70);

  fill(20, 40, 60);
  stroke(255);
  strokeWeight(1.5);
  rect(190, 115, 75, 24);

  fill(240, 240, 245);
  stroke(160, 160, 170);
  strokeWeight(2);
  rect(190, 50, 330, 32);
  rect(60, 120, 24, 120);
  rect(320, 120, 24, 120);

  fill(10, 40, 110);
  stroke(10, 40, 110);
  strokeWeight(0.3);
  textSize(9);
  textAlign(CENTER, CENTER);
  text("TECNOLÓGICO NACIONAL DE MÉXICO", 190, 50);

  drawPapelPicado();

  fill(200, 200, 205);
  stroke(10, 40, 110);
  strokeWeight(2);
  rect(190, 180, 330, 10);

  fill(70, 75, 85);
  stroke(50, 55, 65);
  strokeWeight(1);
  rect(200, 300, 400, 230);

  drawAltar(190, 295, 2.3);

  drawServidorYCartel(42, 275, 1.1);

  drawLeoncilloSaludando(95, 265, 1.5);

  drawCursorLight();

  pop();
}

function drawLeoncilloSaludando(x, y, escala) {
  push();
  translate(x, y);
  scale(escala);

  fill(30, 35, 45, 120);
  noStroke();
  ellipse(0, 25, 26, 7);

  fill(15, 32, 80);
  stroke(5, 15, 45);
  strokeWeight(0.8);
  rect(-4, 16, 5, 14, 1);
  rect(4, 16, 5, 14, 1);

  fill(200, 140, 70);
  noStroke();
  ellipse(-5, 24, 6, 4);
  ellipse(5, 24, 6, 4);

  fill(15, 32, 80);
  stroke(5, 15, 45);
  strokeWeight(0.8);
  rect(0, 2, 14, 16, 2);

  fill(240, 95, 12);
  noStroke();
  rect(0, -4.5, 14, 4, 1);

  fill(255);
  triangle(-3, -7, 0, -3, 3, -7);

  fill(0, 170, 230);
  stroke(5, 15, 45);
  strokeWeight(0.6);
  rect(-8, -3, 4, 6, 1);
  fill(0, 165, 90);
  rect(-8, 0.5, 4, 2.5, 0.5);

  fill(200, 140, 70);
  noStroke();
  ellipse(-9, 5, 5, 5);

  fill(200, 140, 70);
  stroke(140, 90, 40);
  strokeWeight(0.6);
  triangle(-8, -16, -11, -25, -3, -19);
  triangle(8, -16, 11, -25, 3, -19);
  fill(245, 230, 205);
  noStroke();
  triangle(-7, -17, -9, -22, -4, -19);
  triangle(7, -17, 9, -22, 4, -19);

  fill(200, 140, 70);
  stroke(140, 90, 40);
  strokeWeight(0.8);
  ellipse(0, -15, 19, 17);

  fill(250, 245, 230);
  noStroke();
  ellipse(0, -11, 11, 8);

  fill(110, 45, 20);
  triangle(0, -14, -2.5, -12, 2.5, -12);

  fill(255, 215, 0);
  stroke(40);
  strokeWeight(0.5);
  ellipse(-4, -16, 4.5, 5);
  ellipse(4, -16, 4.5, 5);

  fill(20);
  noStroke();
  ellipse(-3.8, -16, 2, 2.5);
  ellipse(3.8, -16, 2, 2.5);

  stroke(40);
  strokeWeight(0.8);
  noFill();
  arc(0, -10, 6, 4, 0, 180);

  push();
  translate(6, -5);
  rotate(-45 + sin(frameCount * 3) * 6);

  fill(240, 95, 12);
  stroke(5, 15, 45);
  strokeWeight(0.5);
  rect(2, -2, 5, 3, 1);

  fill(0, 170, 230);
  rect(3, 1, 5, 4, 1);

  fill(0, 165, 90);
  rect(3, 3.5, 5, 2, 0.5);

  stroke(200, 140, 70);
  strokeWeight(3);
  line(3, 3, 8, -3);

  push();
  translate(8, -3);
  rotate(-15 + sin(frameCount * 10) * 32);

  stroke(200, 140, 70);
  strokeWeight(3.2);
  line(0, 0, 0, -9);
  fill(200, 140, 70);
  noStroke();
  ellipse(0, -10, 6, 6);

  pop();
  pop();

  pop();
}

function drawServidorYCartel(x, y, escala) {
  push();
  translate(x, y);
  scale(escala);

  fill(30, 35, 45, 130);
  noStroke();
  ellipse(0, 24, 26, 8);

  fill(35, 38, 45);
  stroke(15, 18, 25);
  strokeWeight(1);
  rect(0, 0, 22, 46, 2);

  for (let i = -16; i <= 16; i += 8) {
    fill(25, 28, 35);
    stroke(50, 55, 65);
    strokeWeight(0.6);
    rect(0, i, 18, 6, 1);

    stroke(10);
    strokeWeight(0.5);
    line(-6, i, 0, i);

    noStroke();
    let blinkGreen = (frameCount + i * 5) % 30 < 18 ? color(0, 255, 120) : color(0, 80, 30);
    let blinkBlue = (frameCount * 2 + i * 3) % 20 < 10 ? color(0, 200, 255) : color(0, 60, 100);

    fill(blinkGreen);
    ellipse(4, i, 1.8, 1.8);
    fill(blinkBlue);
    ellipse(7, i, 1.8, 1.8);
  }

  push();
  translate(0, -35);

  fill(100);
  stroke(60);
  strokeWeight(0.8);
  rect(0, 7, 2, 8);

  fill(255, 248, 230);
  stroke(10, 40, 110);
  strokeWeight(0.8);
  rect(0, 0, 54, 15, 2);

  fill(10, 40, 110);
  noStroke();
  textAlign(CENTER, CENTER);
  textFont('sans-serif');
  textStyle(BOLD);
  textSize(3.5);
  text("ING. SISTEMAS", 0, -3.2);
  textSize(3.2);
  text("COMPUTACIONALES", 0, 3.2);
  pop();

  pop();
}

function drawLogoTuerca(x, y, escala) {
  push();
  translate(x, y);
  scale(escala);

  fill(255);
  stroke(255);
  ellipse(0, 0, 36, 36);

  fill(10, 35, 100);
  stroke(10, 35, 100);
  strokeWeight(0.5);

  push();
  for (let a = 0; a < 360; a += 45) {
    rotate(45);
    rect(0, -14, 6, 5, 1);
  }
  pop();
  ellipse(0, 0, 24, 24);

  fill(125, 195, 35);
  noStroke();
  ellipse(0, 0, 18, 18);

  stroke(10, 35, 100);
  strokeWeight(0.6);
  noFill();
  ellipse(0, 0, 14, 14);

  fill(10, 35, 100);
  noStroke();
  ellipse(0, 0, 10, 10);

  fill(255);
  ellipse(0, 0, 4, 4);

  pop();
}

function drawPapelPicado() {
  push();
  let colors = [
    color(255, 87, 34),
    color(233, 30, 99),
    color(156, 39, 176),
    color(0, 188, 212),
    color(255, 235, 59),
    color(76, 175, 80)
  ];

  for (let i = 0; i < 6; i++) {
    push();
    let xPos = 85 + i * 42;
    let yPos = 72 + sin(frameCount * 5 + i * 30) * 3;
    translate(xPos, yPos);
    fill(colors[i]);
    stroke(colors[i]);
    strokeWeight(1);
    rect(0, 0, 32, 14);
    fill(10, 14, 30);
    stroke(10, 14, 30);
    ellipse(0, 0, 4, 4);
    pop();
  }
  pop();
}

function drawFlorCempasuchil(x, y, radio) {
  push();
  translate(x, y);

  fill(230, 81, 0);
  noStroke();
  for (let a = 0; a < 360; a += 45) {
    let px = cos(a) * (radio * 0.55);
    let py = sin(a) * (radio * 0.55);
    ellipse(px, py, radio * 0.8, radio * 0.8);
  }

  fill(255, 140, 0);
  for (let a = 22.5; a < 360; a += 45) {
    let px = cos(a) * (radio * 0.3);
    let py = sin(a) * (radio * 0.3);
    ellipse(px, py, radio * 0.7, radio * 0.7);
  }

  fill(255, 214, 0);
  ellipse(0, 0, radio * 0.6, radio * 0.6);
  pop();
}

function drawCalaveritaDeAzucar(x, y, escala, colorDeco) {
  push();
  translate(x, y);
  scale(escala);

  fill(30, 35, 45, 100);
  noStroke();
  ellipse(0, 4, 10, 3);

  fill(255, 252, 245);
  stroke(200, 190, 180);
  strokeWeight(0.5);
  ellipse(0, -2, 9, 8);
  rect(0, 2, 5, 4, 1);

  fill(colorDeco);
  noStroke();
  ellipse(-2.2, -2.5, 2.8, 2.8);
  ellipse(2.2, -2.5, 2.8, 2.8);

  fill(20);
  ellipse(-2.2, -2.5, 1.2, 1.2);
  ellipse(2.2, -2.5, 1.2, 1.2);

  fill(40);
  triangle(0, -0.8, -0.7, 0.5, 0.7, 0.5);

  stroke(120);
  strokeWeight(0.4);
  line(-1.8, 2.2, 1.8, 2.2);
  line(-1, 1.2, -1, 3.2);
  line(0, 1.2, 0, 3.2);
  line(1, 1.2, 1, 3.2);

  fill(255, 215, 0);
  noStroke();
  ellipse(0, -5, 2, 2);
  fill(colorDeco);
  ellipse(-1.5, -5, 1.2, 1.2);
  ellipse(1.5, -5, 1.2, 1.2);

  pop();
}

function drawAltar(x, y, escala) {
  push();
  translate(x, y);
  scale(escala);

  fill(30, 35, 45, 140);
  noStroke();
  ellipse(0, 32, 110, 18);

  fill(245, 245, 250);
  stroke(190, 190, 200);
  strokeWeight(0.7);
  rect(0, 20, 96, 18, 2);
  for (let i = -40; i <= 40; i += 12) {
    drawFlorCempasuchil(i, 27, 2.5);
  }

  fill(240, 240, 245);
  stroke(180, 180, 190);
  strokeWeight(0.7);
  rect(0, 4, 72, 16, 2);
  fill(233, 30, 99);
  noStroke();
  for (let i = -28; i <= 28; i += 8) {
    ellipse(i, 10, 4, 4);
  }

  fill(250, 250, 255);
  stroke(170, 170, 180);
  strokeWeight(0.7);
  rect(0, -11, 50, 14, 2);
  fill(0, 188, 212);
  noStroke();
  for (let i = -18; i <= 18; i += 6) {
    ellipse(i, -5, 3, 3);
  }

  stroke(70, 140, 60);
  strokeWeight(1.5);
  line(0, -28, 0, -18);
  line(-4, -25, 4, -25);

  fill(160, 120, 70);
  stroke(90, 60, 30);
  strokeWeight(0.6);
  rect(-15, -17, 8, 10);
  rect(15, -17, 8, 10);
  fill(230);
  noStroke();
  rect(-15, -17, 6, 8);
  rect(15, -17, 6, 8);
  fill(70);
  ellipse(-15, -18, 2.5, 2.5);
  ellipse(15, -18, 2.5, 2.5);

  fill(200, 230, 255, 190);
  stroke(255);
  strokeWeight(0.4);
  rect(-6, -17, 3, 5);
  rect(6, -17, 3, 5);

  fill(210, 140, 60);
  stroke(140, 80, 20);
  strokeWeight(0.4);
  ellipse(0, -2, 10, 6);
  fill(230, 160, 80);
  ellipse(0, -4, 3, 3);

  fill(165, 82, 40);
  stroke(100, 45, 15);
  strokeWeight(0.5);
  rect(-26, 4, 8, 10, 1);
  rect(26, 4, 8, 10, 1);

  fill(45, 125, 50);
  noStroke();
  ellipse(-26, -1, 10, 4);
  ellipse(26, -1, 10, 4);

  drawFlorCempasuchil(-29, -5, 3.5);
  drawFlorCempasuchil(-23, -6, 3.5);
  drawFlorCempasuchil(-26, -9, 4);

  drawFlorCempasuchil(23, -5, 3.5);
  drawFlorCempasuchil(29, -6, 3.5);
  drawFlorCempasuchil(26, -9, 4);

  fill(150, 75, 35);
  stroke(90, 40, 15);
  strokeWeight(0.4);
  ellipse(-12, -1, 8, 4);
  ellipse(12, -1, 8, 4);

  drawCalaveritaDeAzucar(-18, 14, 1.1, color(233, 30, 99));
  drawCalaveritaDeAzucar(18, 14, 1.1, color(0, 188, 212));

  fill(110, 50, 25);
  stroke(70, 25, 10);
  strokeWeight(0.4);
  ellipse(0, 15, 12, 6);
  fill(55, 25, 10);
  noStroke();
  ellipse(0, 14, 9, 4);

  drawCandle(-36, 14, 8);
  drawCandle(-24, 16, 7);
  drawCandle(24, 16, 7);
  drawCandle(36, 14, 8);

  pop();
}

function drawCandle(cx, cy, h) {
  push();
  translate(cx, cy);

  fill(255, 250, 235);
  stroke(200, 180, 130);
  strokeWeight(0.4);
  rect(0, 0, 3.5, h, 1);

  let glow = 8 + sin(frameCount * 12 + cx * 10) * 2;
  fill(255, 180, 40, 45);
  noStroke();
  ellipse(0, -h / 2 - 1, glow, glow);

  fill(255, 190, 30);
  ellipse(0, -h / 2 - 1, 2.5, 4);
  fill(255, 255, 220);
  ellipse(0, -h / 2 - 0.5, 1.2, 2);

  pop();
}

function drawCursorLight() {
  if (mouseX > 0 && mouseY > 0) {
    let mx = mouseX / (width / 400);
    let my = mouseY / (height / 400);

    noStroke();
    fill(255, 240, 180, 15);
    ellipse(mx, my, 120, 120);
    fill(255, 240, 180, 30);
    ellipse(mx, my, 60, 60);
    fill(255, 250, 210, 50);
    ellipse(mx, my, 20, 20);
  }
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}
