function setup() {
  createCanvas(800, 320);
  angleMode(DEGREES);
  rectMode(CENTER);
  ellipseMode(CENTER);
}

function draw() {
  background(240);

 
  push();
    translate(70, 160);
    scale(0.85);
    rotate(-5);
    
    dibujarGato(color(255, 200, 140)); 
    
    
    fill(255, 100, 150);
    stroke(0);
    strokeWeight(1.5);
    ellipse(0, 10, 16, 12);  
    fill(255);
    ellipse(0, 10, 8, 8);    
  pop();


  push();
    translate(210, 160);
    scale(1.05);
    rotate(3);
    
    dibujarGato(color(250, 160, 60)); 
  pop();


  push();
    translate(360, 160);
    scale(1.25);
    rotate(-3);
    
    dibujarGato(color(240, 130, 30)); 
    
    
    stroke(0);
    strokeWeight(2);
    noFill();
    ellipse(-10, -4, 15, 15); 
    ellipse(10, -4, 15, 15);  
    line(-3, -4, 3, -4);      

    
    fill(220, 40, 40);
    stroke(0);
    strokeWeight(1.5);
    rect(0, 22, 8, 5);              
    triangle(0, 22, -7, 50, 7, 50);  
  pop();

  
  push();
    translate(520, 160);
    scale(1.5);
    rotate(2);
    
    dibujarGato(color(180, 80, 15)); 
    
    
    fill(50, 30, 20);
    noStroke();
    arc(-6, 8, 12, 8, 180, 360);
    arc(6, 8, 12, 8, 180, 360);
  pop();


  push();
    translate(680, 160);
    scale(1.65);
    rotate(-4);
    
    dibujarGato(color(170, 150, 140)); 
    
    
    stroke(40);
    strokeWeight(1.8);
    noFill();
    rect(-10, -3, 15, 9, 2);   
    rect(10, -3, 15, 9, 2);   
    line(-2, -3, 2, -3);       
    line(-17, -3, -22, -5);    
    line(17, -3, 22, -5);     
  pop();
}


function dibujarGato(colorPiel) {
  stroke(0);
  strokeWeight(2);
  fill(colorPiel);

  
  triangle(-20, -12, -12, -30, -3, -12);
  triangle(3, -12, 12, -30, 20, -12);
  
  ellipse(0, 0, 46, 40);


  fill(0);
  noStroke();
  ellipse(-10, -4, 4, 4);
  ellipse(10, -4, 4, 4);

  
  fill(255, 140, 150);
  triangle(-3, 2, 3, 2, 0, 5);

  
  stroke(0);
  strokeWeight(1);
  line(-18, 2, -28, 0);
  line(-18, 6, -28, 7);
  line(18, 2, 28, 0);
  line(18, 6, 28, 7);
}
